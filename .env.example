# CoastGuard AI — Environment Variables
# Copy this to .env and fill in your Gnani API key

GNANI_API_KEY=your_gnani_api_key_here

# Gnani API Endpoints (from docs.gnani.ai)
GNANI_STT_URL=https://app.gnani.ai/api/v1/transcribe
GNANI_TTS_URL=https://app.gnani.ai/api/v1/synthesize

# App Config
APP_HOST=0.0.0.0
APP_PORT=8000
ALERT_RADIUS_KM=2.0
